# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# Google GenAI (document extraction)
GOOGLE_GENAI_API_KEY=

# Plaid (Treasury module — use sandbox for development)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Dev-only treasury seed route (POST /api/dev/seed-journey1)
SEED_SECRET=

# Spec B1 — MCP dev bearer tokens (must be false in prod once OAuth lands)
MCP_DEV_TOKENS_ENABLED=false
# Gate / mcp-remote target (local dev or Vercel deploy URL + /api/mcp)
MCP_GATE_URL=http://localhost:3000/api/mcp

# Spec B2 — MCP OAuth (authorization server + JWT access tokens)
MCP_OAUTH_ISSUER=http://localhost:3000
MCP_OAUTH_SIGNING_SECRET=
# Optional overrides
# MCP_RESOURCE_URL=http://localhost:3000/api/mcp
# MCP_OAUTH_ACCESS_TTL_SEC=3600
# MCP_OAUTH_REFRESH_TTL_SEC=2592000
